page{background:#faf7f1;color:#352c28;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC",sans-serif;font-size:28rpx;line-height:1.65}view,button,input,textarea{box-sizing:border-box}button{font-family:inherit;font-size:28rpx;color:inherit;background:transparent;line-height:1.5;border-radius:22rpx;margin:0;padding:20rpx 24rpx;min-height:88rpx;font-weight:500}button::after{border:0}button[disabled]{opacity:.45}input,textarea{font:inherit;color:inherit;background:#fffcf8;border:1rpx solid #eee8e0;border-radius:20rpx;width:100%;padding:22rpx 24rpx;min-height:88rpx}textarea{height:210rpx;line-height:1.8}input{height:92rpx}.page{padding:24rpx 40rpx calc(40rpx + env(safe-area-inset-bottom))}.brand{display:flex;gap:12rpx;align-items:center;font-size:38rpx;font-weight:700;letter-spacing:-1rpx}.brand image{width:60rpx;height:60rpx}.brand small{font-size:18rpx;color:#ae9d8d}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.title{font-size:44rpx;line-height:1.45;font-weight:600;margin:30rpx 0 12rpx;letter-spacing:0}.sub{font-size:26rpx;line-height:1.8;color:#8c7e73}.small{font-size:24rpx;color:#8c7e73}.tiny{font-size:22rpx;color:#8c7e73;line-height:1.8}.primary{background:#eac5a5;width:100%;font-size:28rpx;font-weight:600;border-radius:24rpx;padding:24rpx;margin-top:28rpx;min-height:96rpx}.secondary{background:#f0ebe4;min-height:88rpx;font-size:26rpx}.text-button{font-size:24rpx;color:#786a60;padding:18rpx 0;min-height:88rpx}.section{margin-top:40rpx}.section-title{font-size:30rpx;font-weight:600;margin:0 0 20rpx}.notice{font-size:24rpx;line-height:1.85;color:#786b60;background:#f3eee6;border-radius:22rpx;padding:24rpx;margin:24rpx 0}.error{background:#f4e6df;color:#975c49}.empty{text-align:center;padding:40rpx 24rpx;color:#8c7e73;font-size:26rpx}.empty image{width:140rpx;height:140rpx;display:block;margin:0 auto 20rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36rpx 26rpx}.cover{height:360rpx;background:#f0eade;border-radius:18rpx;overflow:hidden;position:relative}.cover image{width:100%;height:100%}.cover-title{font-size:28rpx;font-weight:500;margin-top:16rpx;line-height:1.6}.pill{display:inline-block;font-size:20rpx;background:#fffaf0e8;color:#796b60;padding:4rpx 12rpx;border-radius:20rpx;position:absolute;bottom:12rpx;left:12rpx}.footer-entry{border-top:1rpx solid #eee8e0;margin-top:40rpx;padding-top:8rpx;color:#8c7e73;text-align:left;font-size:24rpx;width:100%}.label{font-size:28rpx;font-weight:600;margin:34rpx 0 12rpx}.optional{font-size:22rpx;font-weight:400;color:#9b8b7d;margin-left:12rpx}.actions{display:flex;gap:18rpx;margin-top:24rpx}.actions button{flex:1}.center{text-align:center}.divider{border-top:1rpx solid #eee8e0;margin:28rpx 0}.danger{color:#a16e5e}.canvas-hidden{position:fixed;left:-3000px;top:0;width:900px;height:1200px;pointer-events:none}.loading{padding:60rpx 0;text-align:center;color:#8c7e73;font-size:26rpx}
