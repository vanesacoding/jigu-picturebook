.reader{padding:10rpx 26rpx 36rpx}.book-title{text-align:center;font-size:32rpx;font-weight:600;margin:10rpx 0 24rpx}.book-swiper{width:100%;height:calc((100vw - 52rpx)*4/3)}.book-page{height:100%;background:#fffcf8;border:1rpx solid #e9e1d5;border-radius:5rpx 22rpx 22rpx 5rpx;overflow:hidden;position:relative}.page-art{height:75%;padding:18rpx 18rpx 0}.page-art>image{width:100%;height:100%;border-radius:12rpx}.page-copy{height:25%;padding:10rpx 38rpx 34rpx;display:flex;justify-content:center;align-items:center;text-align:center;white-space:pre-wrap;font-size:32rpx;line-height:1.8;overflow:auto}.page-copy.compact{font-size:26rpx;line-height:1.65}.page-number{position:absolute;bottom:9rpx;left:0;right:0;text-align:center;color:#a29381;font-size:20rpx;background:#fffcf8}.turner{margin:24rpx 0 8rpx}.turner button{min-width:170rpx;font-size:24rpx;background:transparent;border:1rpx solid #e9e1d5}.tools{margin:6rpx 0}.tools button{font-size:24rpx;color:#82746a}.download{width:100%;margin:24rpx 0 16rpx}.waiting{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:24rpx;color:#8c7e73}.waiting image{width:140rpx;height:140rpx}.candidate{padding:24rpx;border:1rpx solid #dce3d1;border-radius:24rpx;background:#f1f2e9;margin-top:24rpx}.candidate>image{width:100%;height:500rpx}
