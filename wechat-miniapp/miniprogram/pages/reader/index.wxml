<view class="page reader"><view wx:if="{{book}}"><view class="row"><button class="text-button" bindtap="shelf">‹ 我的小书</button><text class="tiny">{{sample ? '画面与排版示意' : book.date}}</text></view><view class="book-title">{{book.title}}</view><view wx:if="{{sample}}" class="notice">示例插画采用虚构人物，仅展示阅读排版；实际小书会参考你上传的照片逐页绘画。</view><swiper class="book-swiper" current="{{current}}" bindchange="change" duration="250"><swiper-item wx:for="{{book.pages}}" wx:key="index"><view class="book-page"><view class="page-art"><image wx:if="{{item.image}}" src="{{urls[item.image.id]}}" mode="aspectFit"/><view wx:else class="waiting"><image src="/assets/bird.webp" mode="aspectFit"/><view>这一页还在等叽咕画好</view></view></view><view class="page-copy {{item.text.length > 80 ? 'compact' : ''}}">{{item.text}}</view><view class="page-number">{{index+1}}</view></view></swiper-item></swiper><view class="row turner"><button class="secondary" bindtap="prev" disabled="{{current === 0}}">上一页</button><text class="tiny">{{current+1}} / {{book.count}}</text><button class="secondary" bindtap="next" disabled="{{current === book.count-1}}">下一页</button></view><view wx:if="{{book.pages[current].candidate}}" class="candidate"><view class="section-title">新画面已画好，想留下哪一张？</view><image src="{{urls[book.pages[current].candidate.id]}}" mode="aspectFit"/><view class="actions"><button class="secondary" bindtap="choose" data-accept="no">保留原图</button><button class="secondary" bindtap="choose" data-accept="yes">用新画面</button></view></view><view wx:if="{{!sample}}" class="actions tools"><button bindtap="edit" disabled="{{busy || book.status === 'generating'}}">改改文字</button><button bindtap="redraw" disabled="{{busy || book.status === 'generating'}}">重画这一页</button></view><view wx:if="{{error}}" class="notice error">{{error}}</view><button wx:if="{{!sample &amp;&amp; current === book.count-1}}" class="primary" bindtap="save" disabled="{{busy}}">{{book.saved ? '小书已经收好啦' : '收好这本小书'}}</button><button wx:if="{{sample}}" class="primary" bindtap="create">给宝宝做一本</button><button wx:else class="secondary download" bindtap="download" disabled="{{busy}}">下载整本 PDF</button><view class="tiny center">{{sample ? '示例各页复用一张插画，实际作品每页独立绘画' : '左右滑动翻页 · 小书会一直留在你的书架'}}</view></view><view wx:else class="loading">正在翻开小书…</view><view wx:if="{{error &amp;&amp; !book}}" class="notice error">{{error}}</view><canvas type="2d" id="pdfCanvas" class="canvas-hidden"/></view>