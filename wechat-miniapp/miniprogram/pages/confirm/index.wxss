.segments{display:flex;background:#f0eade;padding:6rpx;border-radius:22rpx;margin:30rpx 0 12rpx}.segments button{flex:1;color:#8c7e73;font-size:26rpx}.segments .selected{background:#fffcf8;color:#352c28}.page-card{margin:30rpx 0;padding:24rpx;border:1rpx solid #eee8e0;border-radius:24rpx;background:#fffcf8}.page-card textarea{border:0;background:transparent;padding:14rpx 0;height:180rpx}.page-card .scene{color:#82746a;font-size:24rpx;height:180rpx}.page-card>.tiny{border-top:1rpx solid #eee8e0;padding-top:16rpx}
