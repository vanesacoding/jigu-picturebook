<view class="page"><view class="title">叽咕其他产品</view><view class="sub">一起读故事，也一起留下自己的故事。</view><view wx:for="{{products}}" wx:key="name" class="product"><image src="/assets/bird.webp" mode="aspectFit"/><view class="section-title">{{item.name}}</view><view class="sub">{{item.description}}</view><button class="primary" data-index="{{index}}" bindtap="open">{{item.appId ? '去读英语绘本' : '复制网页版地址'}}</button></view><view wx:if="{{error}}" class="notice error">{{error}}</view></view>