.photos{display:flex;gap:16rpx;flex-wrap:wrap;margin:24rpx 0 12rpx}.photo,.upload{width:calc((100% - 32rpx)/3);height:212rpx;position:relative}.photo image{width:100%;height:100%;border-radius:20rpx}.delete{position:absolute;right:0;top:0;min-height:64rpx;min-width:64rpx;padding:6rpx;background:#fffaf0e8;border-radius:0 20rpx 0 20rpx;font-size:34rpx}.upload{border:1rpx dashed #d8ccbd;background:#f3eee6;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:42rpx;font-weight:400}.upload view{font-size:24rpx}.short{height:150rpx}.date{background:#fffcf8;border:1rpx solid #eee8e0;padding:22rpx 24rpx;border-radius:20rpx}.consent{display:flex;align-items:flex-start;font-size:24rpx;color:#82746a;gap:12rpx;margin-top:36rpx}checkbox{transform:scale(.8);transform-origin:top left;flex:none}
